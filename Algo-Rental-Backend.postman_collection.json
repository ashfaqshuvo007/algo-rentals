    {
      "name": "Agreement",
      "item": [
        {
          "name": "Initiate Agreement as Tenant",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitId\": \"{{UNIT_ID}}\",\n  \"startDate\": \"2026-10-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/agreement/initiate"
          }
        },
        {
          "name": "Initiate Agreement for Tenant",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"unitId\": \"{{UNIT_ID}}\",\n  \"tenantId\": \"{{TENANT_ID}}\",\n  \"startDate\": \"2026-10-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/agreement/initiate"
          }
        },
        {
          "name": "Agreement Payment Callback",
          "request": {
            "method": "GET",
            "url": "{{BASE_URL}}/api/v1/agreement/create-agreement/payment/callback?paymentID=BKASH_PAYMENT_ID&status=success"
          }
        },
        {
          "name": "Finalize Agreement",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startDate\": \"2026-10-01\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/agreement/{{AGREEMENT_ID}}/finalize"
          }
        },
        {
          "name": "Retry Agreement Payment",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{BASE_URL}}/api/v1/agreement/{{AGREEMENT_ID}}/retry-payment"
          }
        },
        {
          "name": "Request Agreement Termination",
          "request": {
            "method": "POST",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Moving to another city\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/agreement/{{AGREEMENT_ID}}/terminate/request"
          }
        },
        {
          "name": "Terminate Agreement",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Approved termination\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/agreement/{{AGREEMENT_ID}}/terminate"
          }
        },
        {
          "name": "Reject Termination Request",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{BASE_URL}}/api/v1/agreement/{{AGREEMENT_ID}}/terminate/reject"
          }
        }
      ]
    }
