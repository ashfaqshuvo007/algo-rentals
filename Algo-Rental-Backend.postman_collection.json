  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Welcome",
          "request": { "method": "GET", "url": "{{BASE_URL}}/" }
        },
        {
          "name": "Test bKash Integration",
          "request": { "method": "GET", "url": "{{SERVER_URL}}/test" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register Tenant",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Tenant\",\n  \"email\": \"new.tenant@example.com\",\n  \"password\": \"Tenant@12345\",\n  \"tenant\": {\n    \"contactNumber\": \"01700000000\",\n    \"nidNumber\": \"1234567890\",\n    \"presentAddress\": \"Dhaka, Bangladesh\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/register"
          }
        },
        {
          "name": "Login Test Owner",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) pm.collectionVariables.set('ACCESS_TOKEN', json.data.accessToken);",
                  "if (json.data?.refreshToken) pm.collectionVariables.set('REFRESH_TOKEN', json.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_OWNER_EMAIL}}\",\n  \"password\": \"{{TEST_OWNER_PASSWORD}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/login"
          }
        },
        {
          "name": "Login Test Tenant",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data?.accessToken) pm.collectionVariables.set('ACCESS_TOKEN', json.data.accessToken);",
                  "if (json.data?.refreshToken) pm.collectionVariables.set('REFRESH_TOKEN', json.data.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_TENANT_EMAIL}}\",\n  \"password\": \"{{TEST_TENANT_PASSWORD}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/login"
          }
        },
        {
          "name": "Get Logged-in User",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{BASE_URL}}/api/v1/auth/me"
          }
        },
        {
          "name": "Google Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idToken\": \"GOOGLE_ID_TOKEN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/google"
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_TENANT_EMAIL}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/forgot-password"
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{TEST_TENANT_EMAIL}}\",\n  \"newPassword\": \"Tenant@12345\",\n  \"otp\": \"OTP_FROM_EMAIL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/reset-password"
          }
        },
        {
          "name": "Verify Email",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"new.tenant@example.com\",\n  \"otp\": \"OTP_FROM_EMAIL\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{BASE_URL}}/api/v1/auth/verify-email"
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "url": "{{BASE_URL}}/api/v1/auth/refresh-token"
          }
        }
      ]
