    {
      "name": "Tenant",
      "item": [
        {
          "name": "Upload Profile Image",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [{ "key": "profileImage", "type": "file", "src": "" }]
            },
            "url": "{{BASE_URL}}/api/v1/tenant/profile-image"
          }
        },
        {
          "name": "Upload Tenant NID",
          "request": {
            "method": "PATCH",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nid", "type": "file", "src": "" },
                { "key": "nidNumber", "value": "1234567890", "type": "text" }
              ]
            },
            "url": "{{BASE_URL}}/api/v1/tenant/nid"
          }
        }
      ]
    },
