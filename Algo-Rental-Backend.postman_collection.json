    {
      "name": "Unit",
      "item": [
        {
          "name": "Get All Units",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{ACCESS_TOKEN}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{BASE_URL}}/api/v1/unit?limit=10&page=1&status=VACANT&type=ROOM&propertyId={{PROPERTY_ID}}"
          }
        },
        {
          "name": "Get Single Unit",
          "request": {
            "method": "GET",
