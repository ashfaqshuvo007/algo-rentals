model Property {
  id        String   @id @default(uuid())
  name      String    @unique
  address   String

  ownerId   String? @unique
  owner     Owner? @relation(fields: [ownerId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  units     Unit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}
